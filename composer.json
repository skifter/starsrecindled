{
  "name": "skifter/starsrecindled",
  "description": "Symfony bundle for asynchronous turn submission, generation and notifications in the web-based Stars Recindled 4X game.",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Skifter",
      "email": "js@bellcom.dk"
    }
  ],
  "require": {
    "php": "^8.2",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "doctrine/orm": "^2.20 || ^3.3",
    "symfony/doctrine-messenger": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/mailer": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "require-dev": {
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "symfony/browser-kit": "^7.4 || ^8.0",
    "symfony/phpunit-bridge": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Bellcom\\StarsTurnBundle\\": "src/",
      "Bellcom\\StarsTurnBundle\\Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bellcom\\StarsTurnBundle\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "doctrine/doctrine-migrations-bundle": "Runs the included MariaDB schema migration.",
    "symfony/monolog-bundle": "Recommended for worker and turn-generation logging."
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    }
  },
  "homepage": "https://github.com/skifter/starsrecindled",
  "support": {
    "issues": "https://github.com/skifter/starsrecindled/issues",
    "source": "https://github.com/skifter/starsrecindled"
  }
}
