[Unit]
Description=Reconcile Stars queued turns and notifications
After=network.target mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/stars/current
Environment=APP_ENV=prod
ExecStart=/usr/bin/php bin/console stars:queue:reconcile --no-interaction
PrivateTmp=true
NoNewPrivileges=true
